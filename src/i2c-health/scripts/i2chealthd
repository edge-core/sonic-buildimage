#!/usr/bin/env python3

"""
    i2chealthd
    I2C health monitor daemon for SONiC
"""

from i2c_health_mgr.i2c_health_manager import I2CHealthManager
from i2c_health_mgr.i2c_health_msgs import get_i2c_health_msg
from sonic_py_common import daemon_base, device_info
import threading
import signal
import sys
import traceback

SYSLOG_IDENTIFIER = 'i2c-healthd'

I2C_HEALTH_UPDATE_PERIOD_SECS = 60

class I2CHealthDaemon(daemon_base.DaemonBase):


    def __init__(self):
        """
        A daemon that runs as a service to periodically perform I2C health checks.
        """

        daemon_base.DaemonBase.__init__(self, SYSLOG_IDENTIFIER)
        self.stop_event = threading.Event()
        self.log_level = 'notice'
        self.interval = I2C_HEALTH_UPDATE_PERIOD_SECS




    def deinit(self):
        """
        Destructor.
        :return:
        """


        pass

    def run(self):
        '''
        Check i2c health in an infinite loop.
        '''
        self.log_notice("Starting up...")

        try:
            i2c_mgr = I2CHealthManager(self)
            # Polling i2c devices task
            while True:
                if self.stop_event.is_set():
                    break

                i2c_mgr.handle_device_removal_event(self.stop_event, self.interval)

                if i2c_mgr.is_bus_lock() is False:
                    continue
                else:
                    msg = get_i2c_health_msg(1)
                    self.log_error(msg)

                i2c_mgr.cache_state_db_records()

                if i2c_mgr.stop_i2c_services() is False:
                    msg = get_i2c_health_msg(11)
                    self.log_error(msg)
                    continue
                else:
                    msg = get_i2c_health_msg(7)
                    self.log_notice(msg)

                msg = get_i2c_health_msg(5)
                self.log_notice(msg)
                if i2c_mgr.reset_all_mux() is False:
                    msg = get_i2c_health_msg(12)
                    self.log_error(msg)
                    continue

                if i2c_mgr.is_bus_lock():
                    # After resetting the mux, the I2C bus remains locked.
                    # This indicates the lock is on the master side.
                    # Proceed to reset the I2C master.
                    msg = get_i2c_health_msg(26)
                    self.log_error(msg)
                    try:
                        i2c_mgr.reset_i2c_master()
                    except RuntimeError as e:
                        self.log_error("Failed to reset I2C master: {}".format(repr(e)))
                        self.log_error(traceback.format_exc())
                        # Reset I2C master failed, the I2C bus is still locked.
                        continue

                    # Slave-side locks are already resolved by the first reset_all_mux();
                    # repeating it after reset_i2c_master() is unnecessary and unintended.
                    # Therefore, just check the I2C bus status here.
                    if i2c_mgr.is_bus_lock():
                        msg = get_i2c_health_msg(27)
                        self.log_error(msg)
                        continue

                msg = get_i2c_health_msg(2)
                self.log_notice(msg)

                if i2c_mgr.set_all_fans_full_speed() is False:
                    msg = get_i2c_health_msg(13)
                    self.log_error(msg)
                else:
                    msg = get_i2c_health_msg(6)
                    self.log_notice(msg)

                msg = get_i2c_health_msg(8)
                self.log_notice(msg)
                i2c_mgr.scan_faulty_devices()
                msg = get_i2c_health_msg(9)
                self.log_notice(msg)

                i2c_mgr.restore_state_db_records(self.stop_event)

                msg = get_i2c_health_msg(10)
                self.log_notice(msg)
                i2c_mgr.start_i2c_services()


                self.log_notice("Event wait timed out; performing I2C health check...")

        except Exception as e:
            self.log_error("Unhandled exception in run(): {}".format(repr(e)))
            self.log_error(traceback.format_exc())


        self.deinit()


    # Signal handler
    def signal_handler(self, sig, frame):
        """
        Signal handler
        :param sig: Signal number
        :param frame: not used
        :return:
        """
        if sig == signal.SIGHUP:
            self.log_notice("Caught SIGHUP - ignoring...")
        elif sig == signal.SIGINT:
            self.log_notice("Caught SIGINT - exiting...")
            self.stop_event.set()
        elif sig == signal.SIGTERM:
            self.log_notice("Caught SIGTERM - exiting...")
            self.stop_event.set()
        else:
            self.log_warning("Caught unhandled signal '" + sig + "'")

#
# Main =========================================================================
#
def main():
    i2c_healthd = I2CHealthDaemon()
    i2c_healthd.run()


if __name__ == '__main__':
    main()
