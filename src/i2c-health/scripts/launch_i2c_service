#!/usr/bin/env python3

import sys
import subprocess
import syslog
import time
from sonic_py_common import device_info

SUPPORT_PLATFORM = [
    'x86_64-accton_as9716_32d-r0'
]

def is_platform_support():
    platform = device_info.get_platform()
    return True if platform in SUPPORT_PLATFORM else False, platform

def wait_for_pmon_ready(timeout=120, interval=5):
    """Wait for pmon container's dependent-startup to complete"""
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            result = subprocess.run(
                ['docker', 'exec', 'pmon', 'supervisorctl', 'status', 'dependent-startup'],
                capture_output=True, text=True, timeout=10
            )
            if 'EXITED' in result.stdout:
                syslog.syslog(syslog.LOG_NOTICE,
                    "pmon dependent-startup completed, proceeding to start i2c-health service")
                return True
        except Exception:
            pass

        syslog.syslog(syslog.LOG_NOTICE,
            f"Waiting for pmon dependent-startup to complete, retrying in {interval}s...")
        time.sleep(interval)

    syslog.syslog(syslog.LOG_ERR,
        f"pmon dependent-startup not completed after {timeout}s timeout")
    return False

def start_i2c_health_service():
    service = 'i2c-health'
    try:
        result = subprocess.run(['sudo', 'systemctl', 'start', service], check=True, text=True, capture_output=True)

        syslog.syslog(syslog.LOG_NOTICE, f"Service {service} started successfully")
        return 0

    except subprocess.CalledProcessError as e:

        syslog.syslog(syslog.LOG_ERR, f"Failed to start service {service}.")
        syslog.syslog(syslog.LOG_ERR, f"Error: {e.stderr}")
        return 1

if __name__ == '__main__':

    syslog.syslog(syslog.LOG_NOTICE, f"Starting i2c-health-launcher service")

    is_supported, platform = is_platform_support()

    if is_supported:
        syslog.syslog(syslog.LOG_NOTICE, f"The i2c-health service is supported on Platform {platform}")
        if wait_for_pmon_ready():
            sys.exit(start_i2c_health_service())
        else:
            syslog.syslog(syslog.LOG_ERR,
                "Skipping i2c-health service start due to pmon not ready")
            sys.exit(1)
    else:
        syslog.syslog(syslog.LOG_NOTICE, f"The i2c-health service is not supported on Platform {platform}")

    syslog.syslog(syslog.LOG_NOTICE, f"Stopping i2c-health-launcher service")
    sys.exit(0)
