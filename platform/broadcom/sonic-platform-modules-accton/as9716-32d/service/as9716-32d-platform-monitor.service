[Unit]
Description=Accton AS9716-32D Platform Monitoring service
Before=pmon.service
After=as9716-32d-platform-init.service
Requires=as9716-32d-platform-init.service

[Service]
ExecStart=/usr/local/bin/accton_as9716_32d_monitor.py
KillSignal=SIGTERM
SuccessExitStatus=SIGTERM SIGKILL
#StandardOutput=tty

# Resource Limitations
LimitCORE=infinity

[Install]
WantedBy=multi-user.target
