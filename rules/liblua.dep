
SPATH       := $($(LIBLUA)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/liblua.mk rules/liblua.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(SPATH))

$(LIBLUA)_CACHE_MODE  := GIT_CONTENT_SHA
$(LIBLUA)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(LIBLUA)_DEP_FILES   := $(DEP_FILES)

