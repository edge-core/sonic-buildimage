     struct es9618xx_fan_data *data = i2c_get_clientdata(client);
 
     sysfs_remove_group(&client->dev.kobj, &es9618xx_fan_group);
     kfree(data);
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,0,0)
+    return 0;
+#endif
 }
 
